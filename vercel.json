{
  "rewrites": [
    {
      "source": "/classroom/:path*",
      "destination": "/classroom/index.html"
    },
    {
      "source": "/settings/:path*",
      "destination": "/settings/index.html"
    },
    {
      "source": "/spotter/:path*",
      "destination": "/spotter/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/js/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
